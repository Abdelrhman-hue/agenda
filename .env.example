# =============================================
# Environment Variables Template — Agendah
# Copy this file to .env.local and fill values
# =============================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/agendah"

# --- NextAuth ---
AUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# --- Agent API Key (X-API-Key) ---
# مفتاح آمن للـ Agent يستخدمه للوصول لـ /api/agent/* endpoints
# أنشئه بـ: openssl rand -hex 32
AGENT_API_KEY="your-secure-agent-api-key-here"

# --- Payment Webhook Secret ---
# سيُستخدم للتحقق من توقيع webhook في الإنتاج (Kashier / Paymob)
PAYMENT_WEBHOOK_SECRET=""

# --- Google OAuth (optional) ---
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# --- App URL ---
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
